# Домен, на который указывает A-запись вашего VPS. Caddy получит для него
# сертификат Let's Encrypt автоматически.
PCMATE_DOMAIN=relay.example.com

# info | debug | warn | error
PCMATE_LOG_LEVEL=info

# Закрыть регистрацию новых устройств после того, как всё настроено.
PCMATE_ALLOW_REGISTRATION=true

# Необязательный общий секрет: без него /devices/register отклоняет запросы.
# Сгенерировать: openssl rand -base64 24
PCMATE_REGISTRATION_SECRET=
